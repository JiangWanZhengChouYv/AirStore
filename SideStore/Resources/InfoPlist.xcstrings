{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirStore can use local network access to discover Bonjour (mDNS) services on your network. This is not required for core functionality."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirStore 可以访问本地网络，用于发现局域网中的 Bonjour（mDNS）服务。核心功能不需要这项权限。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirStore uses location updates to keep background operations active."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirStore 会接收位置更新，让后台任务保持运行。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
