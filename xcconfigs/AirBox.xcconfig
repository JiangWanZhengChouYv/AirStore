#include "../Build.xcconfig"

// A second app that runs other apps inside itself. Its bundle id is the store's with one more
// component, which is also how it finds the shared app group at runtime (GuestStore.swift).
PRODUCT_BUNDLE_IDENTIFIER = $(MAIN_BUNDLE_IDENTIFIER).AirBox
CODE_SIGN_ENTITLEMENTS = AirBox/AirBox.entitlements

// A single 1024 icon in the synchronised folder; without the name set, actool compiles the catalog
// but embeds no app icon at all.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// The engine is compiled into this target as two synchronised folders under Dependencies/LiveContainer
// (the fork's branch), exactly the way upstream compiles it into its own app. Searching the same
// directories is what lets its sources find each other and the dyld header Apple does not ship.
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Dependencies/LiveContainer/LiveContainer $(SRCROOT)/Dependencies/LiveContainer/LiveContainer/Tweaks $(SRCROOT)/Dependencies/LiveContainer/litehook/src $(SRCROOT)/Dependencies/LiveContainer/Include $(SRCROOT)/Dependencies/LiveContainer/LiveContainerSwiftUI $(SRCROOT)/Dependencies/LiveContainer/LiveContainerSwiftUI/Utilities $(SRCROOT)/Dependencies/LiveContainer/MultitaskSupport $(SRCROOT)/Dependencies/LiveContainer/ZSign $(SRCROOT)/Dependencies/LiveContainer/ZSign/include $(SRCROOT)/Dependencies/LiveContainer/OpenSSL/include
OTHER_CPLUSPLUSFLAGS = $(inherited) -std=c++17
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/Dependencies/LiveContainer/OpenSSL/Frameworks/OpenSSL.xcframework/ios-arm64
// LCUtils probes the IORegistry and unarchive.m reads ipa streams; upstream links both by hand.
OTHER_LDFLAGS = $(inherited) -framework IOKit -larchive
SWIFT_OBJC_BRIDGING_HEADER = Dependencies/LiveContainer/LiveContainerSwiftUI/LiveContainerSwiftUI-Bridging-Header.h

// Upstream LiveContainer is Swift 5 code; the store is Swift 6. Compiling the vendored UI under strict
// concurrency turns its singletons into errors, so this target keeps the language mode upstream uses.
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal

#include? "../local.xcconfig"
