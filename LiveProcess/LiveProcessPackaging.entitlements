<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the fake signature on the packaged LiveProcess.appex carries, for the same reason
     AirBoxPackaging.entitlements exists: ldid applies a plist verbatim and knows nothing about
     $(APP_GROUP_IDENTIFIER) or the bundle id it is built under, and an installer that reads a raw
     placeholder rejects the app outright. Mirrors the box's own packaging file. -->
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>XYZ0123456.com.SideStore.SideStore.AirBox.LiveProcess</string>
	<key>com.apple.developer.team-identifier</key>
	<string>XYZ0123456</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.SideStore.SideStore</string>
	</array>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
